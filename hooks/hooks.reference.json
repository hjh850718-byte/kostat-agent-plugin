{
  "_note": "이 파일은 참조용입니다. 파일명이 Claude Code Plugin의 자동 로드 규약(hooks/hooks.json)과 다르므로 Plugin 활성화만으로는 실행되지 않습니다. 각 hook 스크립트가 개인 Windows 경로(C:\\Users\\USER\\...)를 하드코딩하고 있어 실제 실행은 Documents/Claude/claude-tray/ 동기화 사본 + 개인 settings.json 수동 등록으로 이루어집니다. 이 파일의 스키마(공식 Claude Code hooks 형식)만 그대로 settings.json에 복사해 ${CLAUDE_PLUGIN_ROOT}를 실제 경로로 치환하면 됩니다.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-ai-bridge.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-sessionstart.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-detector.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-workspace-router.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-gateguard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-autobackup.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-observe.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-tracelogger.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-handoff-writer.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-compact.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-ai-bridge.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-stop.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
