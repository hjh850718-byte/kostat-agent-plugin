# UI 디자인 MCP 서버용 환경변수 (.env로 복사 후 값 입력 — .env는 .gitignore 처리됨)
# 켤 서버의 변수만 채우면 됩니다. 발급 방법은 docs/11. UI 디자인 MCP 설치 가이드.md 참고.

# Lazyweb — Bearer 토큰 (lazyweb.com에서 무료 발급)
LAZYWEB_MCP_TOKEN=

# InspoAI — API 키 (app.inspoai.io/mcp에서 무료 발급, 신용카드 불필요)
INSPOAI_API_KEY=

# Refero vibe search용 (선택 — 미설정 시 키워드 검색으로 동작)
OPENAI_API_KEY=
