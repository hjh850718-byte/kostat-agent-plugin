{
  "note": "kostat-core 공통 hook 8개 — CLI v2 포맷. 모든 KOSTAT 플러그인이 공통으로 의존하는 안전망/트레이스 hook을 제공합니다. 경로는 ${CLAUDE_PLUGIN_ROOT} 참조 (Windows: python \"...\" 형식 필수).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "프롬프트 분석 → 작업공간(workspace)·Skill 라우팅 안내",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-workspace-router.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "description": "Human Gate 승인 확인",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-gateguard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "description": "수정 전 자동 백업",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-autobackup.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "description": "변경 사항 관찰 로깅",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-observe.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "description": "Trace Log 기록",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-tracelogger.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "description": "에이전트 핸드오프 파일 기록 (.ai-bridge/agent-handoffs/)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-handoff-writer.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "description": ".ai-bridge/ 디렉토리 초기화 (current-plan, task-status, session-context)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-ai-bridge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "description": ".ai-bridge/ 세션 종료 시각 기록",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-ai-bridge.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "컨텍스트 압축 전 상태를 compaction-log.txt에 기록",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-compact.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
