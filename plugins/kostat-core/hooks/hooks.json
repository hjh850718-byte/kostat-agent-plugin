{
  "note": "이 파일은 Plugin Hook 설정 참조입니다. 실제 Hook 등록은 settings.json에서 이루어집니다. kostat-core는 모든 KOSTAT 플러그인이 공통으로 의존하는 안전망/트레이스 hook을 제공합니다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "description": "프롬프트 분석 → 작업공간(workspace)·Skill 라우팅 안내",
        "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-workspace-router.py\"",
        "timeout": 5
      }
    ],
    "PreToolUse": {
      "Write|Edit": [
        {
          "description": "Human Gate 승인 확인",
          "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-gateguard.py\"",
          "timeout": 5
        },
        {
          "description": "수정 전 자동 백업",
          "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-autobackup.py\"",
          "timeout": 5
        }
      ]
    },
    "PostToolUse": {
      "Write|Edit": [
        {
          "description": "변경 사항 관찰 로깅",
          "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-observe.py\"",
          "timeout": 10
        },
        {
          "description": "Trace Log 기록",
          "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-tracelogger.py\"",
          "timeout": 5
        },
        {
          "description": "에이전트 핸드오프 파일 기록 (.ai-bridge/agent-handoffs/)",
          "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-handoff-writer.py\"",
          "timeout": 5
        }
      ]
    },
    "SessionStart": [
      {
        "description": ".ai-bridge/ 디렉토리 초기화 (current-plan, task-status, session-context)",
        "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-ai-bridge.py\"",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "description": ".ai-bridge/ 세션 종료 시각 기록",
        "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-ai-bridge.py\"",
        "timeout": 5
      }
    ],
    "PreCompact": [
      {
        "description": "컨텍스트 압축 전 상태를 compaction-log.txt에 기록",
        "command": "python \"{{PLUGIN_DIR}}/hooks/kostat-compact.py\"",
        "timeout": 5
      }
    ]
  }
}
