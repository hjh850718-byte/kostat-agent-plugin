{
  "note": "kostat-eod 전용 hook 3개 — CLI v2 포맷. 하루 시작/종료 루틴에만 관여합니다. 경로는 ${CLAUDE_PLUGIN_ROOT} 참조 (Windows: python \"...\" 형식 필수).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "사용자 메시지에서 업무종료 키워드 실시간 감지 → flag 파일 기록",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-detector.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "EOD 재접속 감지 (6시 이후 회고 제안)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-sessionstart.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "EOD 세션 로깅 + pending_retro flag",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/kostat-eod-stop.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
